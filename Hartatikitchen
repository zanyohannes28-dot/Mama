<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Hartati Kitchen - Labirin Zombie Dapur!</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito:wght@600;800&display=swap" rel="stylesheet">
<style>
  :root{
    --red:#c8382c; --red-dark:#8f2620; --cream:#fff6e0; --mustard:#f2b705;
    --green:#4a7c3a; --brown:#5a3a22; --path:#ffe9b0;
    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  *{box-sizing:border-box;}
  html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px);}
  body{
    height:100%;margin:0;font-family:'Nunito',sans-serif;
    background:
      repeating-linear-gradient(45deg, var(--red) 0 22px, var(--cream) 22px 44px),
      repeating-linear-gradient(-45deg, var(--red) 0 22px, transparent 22px 44px);
    background-blend-mode:multiply;
    display:flex;align-items:center;justify-content:center;overflow:hidden;
  }
  .wrap{
    width:100%;max-width:480px;height:100%;max-height:900px;
    background:var(--cream);display:flex;flex-direction:column;
    position:relative;overflow:hidden;box-shadow:0 0 40px rgba(0,0,0,.3);
  }
  header{
    background:var(--red-dark);color:var(--cream);
    padding:8px 14px 6px;text-align:center;flex-shrink:0;
    border-bottom:5px solid var(--mustard);
  }
  header h1{font-family:'Baloo 2',cursive;font-weight:800;font-size:19px;margin:0;}
  header p{margin:1px 0 0;font-size:11px;opacity:.9;font-weight:600;}
  .hud{
    display:flex;justify-content:space-between;align-items:center;
    padding:6px 14px;background:var(--mustard);flex-shrink:0;
    font-family:'Baloo 2',cursive;font-weight:700;color:var(--brown);font-size:14px;
  }
  .game-area{
    position:relative;flex:1;overflow:hidden;
    display:flex;flex-direction:column;align-items:center;justify-content:space-between;
    padding:6px 0;min-height:0;
  }
  .maze-wrap{
    position:relative;width:min(88vw,300px);aspect-ratio:9/13;margin:2px auto;flex-shrink:0;
  }
  .maze-grid{
    position:absolute;inset:0;display:grid;
    grid-template-columns:repeat(9,1fr);grid-template-rows:repeat(13,1fr);
    gap:1px;background:var(--brown);border:3px solid var(--brown);border-radius:8px;overflow:hidden;
  }
  .cell.wall{background:var(--brown);}
  .cell.path{background:var(--path);}
  .token{
    position:absolute;display:flex;align-items:center;justify-content:center;
    font-size:clamp(12px,4.5vw,17px);transition:left .12s linear, top .12s linear;
    pointer-events:none;
  }
  .token.zombie{transition:left .35s linear, top .35s linear;}
  .token.hit{animation:blink .15s steps(1) 4;}
  @keyframes blink{50%{opacity:.15;}}
  .toast{
    position:absolute;top:6px;left:50%;transform:translateX(-50%);
    background:var(--brown);color:var(--cream);padding:5px 12px;
    border-radius:18px;font-weight:800;font-family:'Baloo 2',cursive;
    font-size:12px;opacity:0;transition:opacity .2s,top .2s;
    white-space:nowrap;pointer-events:none;z-index:6;max-width:92%;
    overflow:hidden;text-overflow:ellipsis;
  }
  .toast.show{opacity:1;top:14px;}
  .dpad{
    display:grid;grid-template-columns:56px 56px 56px;grid-template-rows:52px 52px 52px;
    gap:4px;flex-shrink:0;margin-bottom:calc(6px + env(safe-area-inset-bottom,0px));
  }
  .dpad button{
    background:#fff;border:3px solid var(--brown);border-radius:12px;
    font-size:22px;box-shadow:0 4px 0 #d9c48e;cursor:pointer;
  }
  .dpad button:active{transform:translateY(3px);box-shadow:0 1px 0 #d9c48e;}
  .dpad .b-up{grid-column:2;grid-row:1;}
  .dpad .b-left{grid-column:1;grid-row:2;}
  .dpad .b-right{grid-column:3;grid-row:2;}
  .dpad .b-down{grid-column:2;grid-row:3;}
  .overlay{
    position:absolute;inset:0;background:rgba(90,58,34,.95);
    color:var(--cream);display:flex;flex-direction:column;
    align-items:center;justify-content:center;text-align:center;
    padding:20px;gap:8px;z-index:5;
  }
  .overlay h2{font-family:'Baloo 2',cursive;font-size:22px;margin:0 0 2px;color:var(--mustard);}
  .overlay p{margin:0;font-size:14px;line-height:1.5;max-width:310px;}
  .emoji-big{font-size:44px;}
  .kidpick{display:flex;gap:10px;margin-top:8px;flex-wrap:wrap;justify-content:center;}
  .kidbtn{
    background:#fff;border:3px solid var(--brown);border-radius:14px;
    padding:8px 10px;display:flex;flex-direction:column;align-items:center;gap:2px;
    cursor:pointer;box-shadow:0 4px 0 #d9c48e;
  }
  .kidbtn:active{transform:translateY(3px);box-shadow:0 1px 0 #d9c48e;}
  .kidbtn .av{font-size:28px;}
  .kidbtn .nm{font-family:'Baloo 2',cursive;font-weight:700;font-size:11px;color:var(--brown);}
  .family{font-size:14px;line-height:1.6;margin-top:4px;}
  button.play-btn{
    margin-top:8px;background:var(--red);color:#fff;border:none;
    font-family:'Baloo 2',cursive;font-weight:700;font-size:17px;
    padding:10px 26px;border-radius:30px;cursor:pointer;
    box-shadow:0 4px 0 var(--red-dark);
  }
  button.play-btn:active{transform:translateY(2px);box-shadow:0 2px 0 var(--red-dark);}
  .hidden{display:none !important;}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>🍳 Hartati Kitchen</h1>
    <p>Labirin Zombie Dapur!</p>
  </header>
  <div class="hud">
    <div id="score">Skor: 0</div>
    <div id="level">Level 1</div>
    <div id="hearts">❤️❤️❤️</div>
  </div>
  <div class="game-area" id="gameArea">
    <div class="maze-wrap" id="mazeWrap">
      <div class="maze-grid" id="mazeGrid"></div>
      <div class="toast" id="toast"></div>
    </div>
    <div class="dpad">
      <button class="b-up" id="bUp">⬆️</button>
      <button class="b-left" id="bLeft">⬅️</button>
      <button class="b-right" id="bRight">➡️</button>
      <button class="b-down" id="bDown">⬇️</button>
    </div>

    <div class="overlay" id="startScreen">
      <div class="emoji-big">🧟🥕</div>
      <h2>Labirin Zombie Dapur!</h2>
      <p>Bu Atik butuh bahan buat masak, tapi dapurnya kemasukan zombie kecoa iseng! Pilih anak yang mau disuruh, terus ambilin semua bahan dan anter ke panci 🍲 tanpa ketangkep zombie.</p>
      <div class="kidpick" id="kidpick"></div>
    </div>

    <div class="overlay hidden" id="overScreen">
      <div class="emoji-big">🍲🔥</div>
      <h2 id="overTitle">Selesai!</h2>
      <p id="overText"></p>
      <button class="play-btn" id="restartBtn">Main Lagi</button>
    </div>
  </div>
</div>

<script>
const COLS=9, ROWS=13;
const MAZE=[
"#########",
"#...#...#",
"#.#.#.#.#",
"#...#...#",
"###.#.###",
"#...#...#",
"#.###.#.#",
"#...#...#",
"###.#.###",
"#...#...#",
"#.#.#.#.#",
"#...#...#",
"#########",
];
const START={r:1,c:1};
const POT={r:11,c:7};
const KIDS=[
  {name:'Diah', avatar:'👧'},
  {name:'Riyadhi', avatar:'🧑'},
  {name:'Yusuf', avatar:'👦'},
  {name:'Rizky', avatar:'🧒'},
];
const FOOD=['🍅','🥕','🧅','🍗','🥚','🌶️','🥔','🌽'];
const PICKUP_MSG=['nemu bahan enak!','langsung ambil cepet!','berhasil dapet satu!','cekatan banget nih!'];
const NEAR_MSG=['Awas! Zombie kecoa ngejar','Zombie kecoa deket banget sama'];
const HIT_MSG=['ketangkep zombie kecoa! Kabur ke awal lagi!','digigit zombie usil, harus mundur!'];

let openCells=[];
for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++) if(MAZE[r][c]==='.') openCells.push({r,c});

let score=0, lives=3, level=1, running=false;
let player={r:START.r,c:START.c};
let kid=KIDS[0];
let zombies=[];
let ingredients=[]; // {r,c,e}
let needed=0, collected=0;
let invuln=false;
let zTimer=null;

const mazeGrid=document.getElementById('mazeGrid');
const mazeWrap=document.getElementById('mazeWrap');
const scoreEl=document.getElementById('score');
const heartsEl=document.getElementById('hearts');
const levelEl=document.getElementById('level');
const startScreen=document.getElementById('startScreen');
const overScreen=document.getElementById('overScreen');
const overTitle=document.getElementById('overTitle');
const overText=document.getElementById('overText');
const kidpick=document.getElementById('kidpick');

let highscore=0;
try{ highscore=parseInt(localStorage.getItem('hartati_hs5')||'0'); }catch(e){}

KIDS.forEach(k=>{
  const b=document.createElement('div');
  b.className='kidbtn';
  b.innerHTML='<span class="av">'+k.avatar+'</span><span class="nm">'+k.name+'</span>';
  b.onclick=()=>{ kid=k; startGame(); };
  kidpick.appendChild(b);
});

function buildGrid(){
  mazeGrid.innerHTML='';
  for(let r=0;r<ROWS;r++){
    for(let c=0;c<COLS;c++){
      const cell=document.createElement('div');
      cell.className='cell '+(MAZE[r][c]==='#'?'wall':'path');
      mazeGrid.appendChild(cell);
    }
  }
}
buildGrid();

function posStyle(r,c){
  return 'left:'+(c/COLS*100)+'%;top:'+(r/ROWS*100)+'%;width:'+(100/COLS)+'%;height:'+(100/ROWS)+'%;';
}

function showToast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg;
  t.classList.add('show');
  clearTimeout(t._t);
  t._t=setTimeout(()=>t.classList.remove('show'),750);
}
function updateHUD(){
  scoreEl.textContent='Skor: '+score;
  levelEl.textContent='Level '+level;
  heartsEl.textContent='❤️'.repeat(Math.max(lives,0))+'🤍'.repeat(3-Math.max(lives,0));
}
function shuffle(arr){ return arr.map(v=>[Math.random(),v]).sort((a,b)=>a[0]-b[0]).map(v=>v[1]); }
function sameCell(a,b){ return a.r===b.r && a.c===b.c; }

function renderTokens(){
  mazeWrap.querySelectorAll('.token').forEach(el=>el.remove());

  const potEl=document.createElement('div');
  potEl.className='token'; potEl.style.cssText=posStyle(POT.r,POT.c); potEl.textContent='🍲';
  mazeWrap.appendChild(potEl);

  ingredients.forEach(ing=>{
    const el=document.createElement('div');
    el.className='token'; el.style.cssText=posStyle(ing.r,ing.c); el.textContent=ing.e;
    mazeWrap.appendChild(el);
  });

  zombies.forEach(z=>{
    const el=document.createElement('div');
    el.className='token zombie'; el.style.cssText=posStyle(z.r,z.c); el.textContent='🧟';
    mazeWrap.appendChild(el);
  });

  const pEl=document.createElement('div');
  pEl.className='token player'+(invuln?' hit':''); pEl.id='playerToken';
  pEl.style.cssText=posStyle(player.r,player.c); pEl.textContent=kid.avatar;
  mazeWrap.appendChild(pEl);
}

function spawnLevel(){
  const usable = openCells.filter(o=>!(o.r===START.r&&o.c===START.c) && !(o.r===POT.r&&o.c===POT.c));
  const picks = shuffle(usable).slice(0, 4+Math.min(level,3));
  ingredients = picks.map(p=>({r:p.r,c:p.c,e:FOOD[Math.floor(Math.random()*FOOD.length)]}));
  needed = ingredients.length; collected=0;

  const zCount = Math.min(1+level, 4);
  const farCells = shuffle(usable.filter(o=>Math.abs(o.r-START.r)+Math.abs(o.c-START.c) > 4));
  zombies = farCells.slice(0,zCount).map(p=>({r:p.r,c:p.c}));

  player={r:START.r,c:START.c};
  renderTokens();
}

function neighbors(r,c){
  const dirs=[[-1,0],[1,0],[0,-1],[0,1]];
  const out=[];
  dirs.forEach(([dr,dc])=>{
    const nr=r+dr, nc=c+dc;
    if(nr>=0&&nr<ROWS&&nc>=0&&nc<COLS&&MAZE[nr][nc]!=='#') out.push({r:nr,c:nc});
  });
  return out;
}

function tryMove(dr,dc){
  if(!running) return;
  const nr=player.r+dr, nc=player.c+dc;
  if(nr<0||nr>=ROWS||nc<0||nc>=COLS||MAZE[nr][nc]==='#') return;
  player={r:nr,c:nc};
  checkPickup();
  checkCollision();
  renderTokens();
}

function checkPickup(){
  const idx = ingredients.findIndex(i=>i.r===player.r&&i.c===player.c);
  if(idx>=0){
    ingredients.splice(idx,1);
    collected++; score+=10; updateHUD();
    showToast(kid.name+' '+PICKUP_MSG[Math.floor(Math.random()*PICKUP_MSG.length)]);
  }
  if(collected>=needed && player.r===POT.r && player.c===POT.c === false){
    // not yet at pot
  }
  if(collected>=needed && sameCell(player,POT)){
    levelComplete();
  } else if(collected>=needed && !sameCell(player,POT)){
    // hint only first time reaching full collect handled via toast below
  }
}

function checkArriveAtPot(){
  if(sameCell(player,POT) && collected>=needed && needed>0){
    levelComplete();
  }
}

function levelComplete(){
  score+=50; level++; updateHUD();
  showToast('🎉 Semua bahan sampai ke Bu Atik! Level naik!');
  clearTimeout(zTimer);
  setTimeout(()=>{
    if(!running) return;
    spawnLevel();
    scheduleZombies();
  }, 700);
}

function checkCollision(){
  if(invuln) return;
  if(zombies.some(z=>sameCell(z,player))){
    lives--; updateHUD();
    invuln=true;
    showToast(kid.name+' '+HIT_MSG[Math.floor(Math.random()*HIT_MSG.length)]);
    if(lives<=0){ endGame(); return; }
    player={r:START.r,c:START.c};
    renderTokens();
    setTimeout(()=>{ invuln=false; renderTokens(); }, 900);
  } else {
    const dmin = Math.min(...zombies.map(z=>Math.abs(z.r-player.r)+Math.abs(z.c-player.c)), 99);
    if(dmin===2 && Math.random()<0.4) showToast(NEAR_MSG[Math.floor(Math.random()*NEAR_MSG.length)]+' '+kid.name+'!');
  }
}

function moveZombies(){
  if(!running) return;
  zombies.forEach(z=>{
    const opts = neighbors(z.r,z.c);
    if(opts.length===0) return;
    let choice;
    if(Math.random()<0.55){
      opts.sort((a,b)=>{
        const da=Math.abs(a.r-player.r)+Math.abs(a.c-player.c);
        const db=Math.abs(b.r-player.r)+Math.abs(b.c-player.c);
        return da-db;
      });
      choice = opts[0];
    } else {
      choice = opts[Math.floor(Math.random()*opts.length)];
    }
    z.r=choice.r; z.c=choice.c;
  });
  renderTokens();
  checkCollision();
  const spd = Math.max(280, 600 - level*40);
  zTimer=setTimeout(moveZombies, spd);
}
function scheduleZombies(){
  clearTimeout(zTimer);
  zTimer=setTimeout(moveZombies, 500);
}

document.getElementById('bUp').onclick=()=>tryMove(-1,0);
document.getElementById('bDown').onclick=()=>tryMove(1,0);
document.getElementById('bLeft').onclick=()=>tryMove(0,-1);
document.getElementById('bRight').onclick=()=>tryMove(0,1);
window.addEventListener('keydown', e=>{
  if(e.key==='ArrowUp') tryMove(-1,0);
  else if(e.key==='ArrowDown') tryMove(1,0);
  else if(e.key==='ArrowLeft') tryMove(0,-1);
  else if(e.key==='ArrowRight') tryMove(0,1);
});

function startGame(){
  score=0; lives=3; level=1; running=true; invuln=false;
  updateHUD();
  startScreen.classList.add('hidden');
  overScreen.classList.add('hidden');
  spawnLevel();
  scheduleZombies();
}

function endGame(){
  running=false;
  clearTimeout(zTimer);
  if(score>highscore){
    highscore=score;
    try{ localStorage.setItem('hartati_hs5', String(highscore)); }catch(e){}
  }
  const lines=[
    kid.name+' sempet dikejar-kejar zombie kecoa, tapi tetep semangat bantu Bu Atik! 😂',
    'Dapur Hartati Kitchen rame banget gara-gara zombie usil ikut nimbrung masak!',
    'Biar sempet ketangkep, '+kid.name+' tetep jadi kurir bahan tercepat di rumah!',
  ];
  overTitle.textContent='Dapur Diserbu Zombie!';
  overText.innerHTML = lines[Math.floor(Math.random()*lines.length)] +
    '<br><div class="family">Skor akhir: <b>'+score+'</b> (Level '+level+') &nbsp;|&nbsp; Rekor: <b>'+highscore+'</b></div>';
  overScreen.classList.remove('hidden');
}

document.getElementById('restartBtn').addEventListener('click', ()=>{
  overScreen.classList.add('hidden');
  startScreen.classList.remove('hidden');
});
</script>
</body>
</html>
